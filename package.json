{
  "name": "motherload-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D browser reimagining of Motherload \u2014 mine Mars for Mr. Natas.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "shots": "node scripts/screenshot.mjs",
    "track": "node tools/opentrack-bridge.mjs",
    "build:single": "vite build --config vite.config.single.js",
    "audio": "node scripts/audio-check.mjs",
    "switches": "node scripts/switch-check.mjs",
    "render": "node scripts/render-track.mjs",
    "jukebox": "vite --open /tools/jukebox/index.html",
    "jukebox-check": "node scripts/jukebox-check.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "ws": "^8.21.1"
  }
}
